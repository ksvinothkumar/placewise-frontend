# Leave empty in dev: Vite proxies /api and /ws to http://localhost:4100.
# Set when the API is on another origin (then the API must allow CORS with credentials).
VITE_API_URL=
VITE_WS_URL=

# Public careers site branding and Google for Jobs data (all optional)
VITE_COMPANY_NAME=
VITE_COMPANY_LOGO=
VITE_COMPANY_TAGLINE=
VITE_COMPANY_ABOUT=
VITE_COMPANY_URL=
VITE_COMPANY_EMAIL=
# Public address of this site, for share links (defaults to the current origin)
VITE_SITE_URL=
